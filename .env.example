# Agent Gateway configuration
# Copy to .env and adjust. Never commit real secrets.

# --- MCP server -----------------------------------------------------------
# The gateway only binds to localhost. Expose it with a Cloudflare Quick
# Tunnel if you need ChatGPT to reach it; set PUBLIC_MCP_HOST to the public
# hostname so the MCP transport security layer permits it.
MCP_HOST=127.0.0.1
MCP_PORT=8000
PUBLIC_MCP_HOST=

# --- Transport authentication ---------------------------------------------
# Bearer token required on every /mcp request. STRONGLY recommended for any
# non-localhost exposure: startup fails if PUBLIC_MCP_HOST is set without a
# token. Localhost-only development needs no token.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_GATEWAY_TOKEN=
# Explicitly accept public exposure WITHOUT a token (not recommended).
# AGENT_INSECURE_NO_TOKEN_OPT_OUT=false

# --- Direct mode ----------------------------------------------------------
# Direct mode is always enabled: deterministic filesystem/search/git tools.
# Process execution is opt-in and runs with the gateway user's OS privileges.
AGENT_ENABLE_COMMANDS=false

# --- Optional OpenCode agent mode (disabled by default) -------------------
# When true, the delegated OpenCode-agent lifecycle tools (agent_start_task,
# agent_status, ...) are registered and require a running OpenCode server.
# Direct mode works without OpenCode and without any model/provider.
ENABLE_OPENCODE_AGENT=false
# The local OpenCode headless server. Keep it localhost-only.
OPENCODE_URL=http://127.0.0.1:4096
# Basic auth is used ONLY when OPENCODE_PASSWORD is non-empty.
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=

# --- Directory security ---------------------------------------------------
# Semicolon-separated list of absolute directories that remote callers may
# work in. If unset, NO directory is allowed (fail closed).
AGENT_ALLOWED_ROOTS=C:\Users\dev\Desktop\sample-repo

# --- Direct-mode limits ---------------------------------------------------
AGENT_MAX_READ_BYTES=200000
AGENT_MAX_TREE_ENTRIES=1000
AGENT_MAX_SEARCH_RESULTS=200
AGENT_MAX_PROCESS_OUTPUT_BYTES=100000
AGENT_PROCESS_TIMEOUT_MAX=300

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO

# --- OpenCode HTTP timeouts (seconds, optional mode) ----------------------
OPENCODE_CONNECT_TIMEOUT=5
OPENCODE_READ_TIMEOUT=60
OPENCODE_WRITE_TIMEOUT=30
OPENCODE_POOL_TIMEOUT=5